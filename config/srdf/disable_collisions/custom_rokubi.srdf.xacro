<?xml version="1.0" ?>
<robot name="pal_sea_arm" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find pal_sea_arm_moveit_config)/config/srdf/disable_collisions/custom.srdf.xacro" />
    <disable_collisions link1="arm_ft_link" link2="arm_ft_tool_link" reason="Adjacent"/>
    <disable_collisions link1="arm_ft_link" link2="cee_tool_link" reason="Adjacent"/>
    <disable_collisions link1="arm_ft_tool_link" link2="cee_tool_link" reason="Adjacent"/>
</robot>
